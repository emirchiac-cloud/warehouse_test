<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Image Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border"
            android:layout_marginBottom="18dp">

            <ImageView
                android:id="@+id/imgDetail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/image_placeholder"
                android:contentDescription="Product Image" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvDetailName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Product Name"
                android:textColor="@color/primary_navy"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN STOCK"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/badge_in_stock" />
        </LinearLayout>

        <!-- Category & SKU -->
        <TextView
            android:id="@+id/tvDetailCategorySku"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category • SKU"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Stock Count & Quick Adjustment Control (Part D Workflow 4) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStockControl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REAL-TIME STOCK COUNT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Quick -1 Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickMinus"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:text="-"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/stock_low" />

                    <!-- Quantity Display -->
                    <TextView
                        android:id="@+id/tvDetailQuantity"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="14"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textColor="@color/primary_navy" />

                    <!-- Quick +1 Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickPlus"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:text="+"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/stock_ok" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThresholdNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Safe Minimum Threshold: 5 units"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product Details / Editing Form -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/card_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Product Details"
                    android:textColor="@color/primary_navy"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Unit Price -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Unit Price ($)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailPrice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Min Stock Threshold -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Min Stock Threshold (Alert Trigger)"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Description -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Description"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDetailDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textMultiLine"
                        android:lines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Save/Update Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveUpdate"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="SAVE / UPDATE DETAILS"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary_navy" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Delete Product Button (with Confirmation AlertDialog) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteProduct"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="DELETE PRODUCT"
            android:textColor="@color/stock_low"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/stock_low"
            android:layout_marginBottom="24dp" />

        <ProgressBar
            android:id="@+id/detailProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
